# ---- Core ----
APP_NAME=tryarnold
LOG_LEVEL=INFO
APP_RUNTIME=worker

# Public HTTPS URL of the Worker (set after first deploy)
PUBLIC_BASE_URL=https://tryarnold.example.workers.dev

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---- LINE ----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---- LLM / Vision (OpenRouter) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_VISION_MODEL=openai/gpt-4o
OPENROUTER_PROVIDER_ORDER=

# ---- Admin ----
ADMIN_SECRET=

# ---- Portion confirmation ----
PORTION_CONFIDENCE_THRESHOLD=0.6
MEAL_CONFIRM_MAX_CALORIES=1200
PENDING_MEAL_TTL_MINUTES=30
PORTION_SIZE_SMALL=0.7
PORTION_SIZE_LARGE=1.3

# ---- Landing page CTAs ----
TELEGRAM_BOT_URL=https://t.me/tryarnold_bot
LINE_ADD_URL=https://line.me/R/ti/p/@386edctb
