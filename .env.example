# ---- Core ----
# Comma-free human label used in logs
APP_NAME=telegram-fitness-coach
LOG_LEVEL=INFO

# Public base URL where Telegram will POST webhooks (e.g. https://abc123.ngrok.io)
PUBLIC_BASE_URL=http://localhost:8000

# ---- Telegram ----
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Random string you generate; Telegram echoes it back in a header so we can
# verify inbound webhook requests genuinely came from Telegram.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---- Database ----
# Async SQLAlchemy URL (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://coach:coach@localhost:5432/coach
# Sync URL used by Alembic + LangGraph postgres checkpointer/store
DATABASE_URL_SYNC=postgresql+psycopg://coach:coach@localhost:5432/coach

# ---- FatSecret ----
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# ---- LLM / Vision  ----
# If unset, the app still boots and uses safe fallbacks (no AI replies).
OPENAI_API_KEY=
# Model used for the coach agent + food-photo macro estimation
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

# ---- Proactive nudges ----
# How often the scheduler evaluates users (minutes)
NUDGE_POLL_MINUTES=15
# Minimum hours between two proactive nudges to the same user
NUDGE_MIN_GAP_HOURS=3
